# Redis MCP Server Configuration Example
# Copy to .env and adjust values for your environment.
# NEVER commit real credentials to version control.

# Redis Target Connection URL (redis:// or rediss://)
REDIS_URL=redis://127.0.0.1:6379/0
# For authenticated TLS: rediss://<username>:<password>@<host>:<port>/<db>

# MCP Server HTTP Binding
MCP_PORT=3000
MCP_HOST=127.0.0.1

# Transport mode (http or stdio)
MCP_TRANSPORT=http

# Timeouts in milliseconds
REDIS_CONNECTION_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000

# Bounded Limits for Key Inspection
REDIS_MAX_SCAN_COUNT=100
REDIS_MAX_RESULTS=100
REDIS_MAX_VALUE_BYTES=65536

# Diagnostic Metadata Configuration
REDIS_METADATA_ENABLED=true
REDIS_METADATA_LEVEL=standard

# Optional TLS Certificate Paths (for custom CA / client certs)
# REDIS_TLS_CA_PATH=/path/to/ca.pem
# REDIS_TLS_CERT_PATH=/path/to/client-cert.pem
# REDIS_TLS_KEY_PATH=/path/to/client-key.pem
# REDIS_TLS_REJECT_UNAUTHORIZED=true
